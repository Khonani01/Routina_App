<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollViewTasks"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_header"
            android:textColor="@color/brand_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tasks"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tasks_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="5dp" />

        <!-- Task summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="25dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/bg_auth_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_tasks"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtTotalTasks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/brand_primary"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="95dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/bg_auth_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/completed_tasks"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtCompletedTasks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#16A34A"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Add task section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_auth_card"
            android:layout_marginTop="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_new_task"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="@string/task_title_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:singleLine="true"
                android:inputType="textCapSentences"
                android:textSize="14sp"
                android:padding="12dp"
                android:backgroundTint="@color/input_stroke"
                android:layout_marginTop="15dp" />

            <EditText
                android:id="@+id/edtTaskDescription"
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:hint="@string/task_desc_hint"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:textSize="14sp"
                android:padding="12dp"
                android:backgroundTint="@color/input_stroke"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_due_date"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="15dp" />

            <Button
                android:id="@+id/btnSelectDate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/select_due_date"
                android:textAllCaps="false"
                android:textColor="@color/secondary_btn_text"
                android:backgroundTint="@color/secondary_btn_bg"
                android:layout_marginTop="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/priority"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="15dp" />

            <Spinner
                android:id="@+id/spinnerPriority"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:entries="@array/task_priorities"
                android:backgroundTint="@color/input_stroke" />

            <Button
                android:id="@+id/btnAddTask"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/add_task_btn"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/brand_primary"
                android:layout_marginTop="20dp" />

        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/your_tasks"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />


        <Spinner
            android:id="@+id/spinnerTaskFilter"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:entries="@array/task_filters"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/input_stroke" />


        <LinearLayout
            android:id="@+id/taskContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/txtEmptyTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_tasks_empty"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="25dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnBackDashboard"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/back_to_dashboard"
            android:textAllCaps="false"
            android:textColor="@color/secondary_btn_text"
            android:backgroundTint="@color/secondary_btn_bg"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
